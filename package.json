{
  "name": "pixel-rogue",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @pixel-rogue/client",
    "dev:server": "npm run dev -w @pixel-rogue/server",
    "build": "npm run build -w @pixel-rogue/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run size && npm run test",
    "size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "oxlint": "^1.86.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
